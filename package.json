{
  "name": "thought-briefing-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:pages": "node scripts/build-github-pages.mjs",
    "validate:pages": "node scripts/validate-pages-assets.mjs",
    "validate:sites": "node scripts/validate-site-structure.mjs",
    "build:sites": "node scripts/build-site.mjs --all",
    "dev:living-atlas": "vite sites/living-atlas",
    "build:living-atlas": "node scripts/build-site.mjs living-atlas",
    "dev:ivory": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build:ivory": "bash scripts/build-verified.sh",
    "dev:enheduanna": "vite --config sites/enheduanna/vite.config.ts",
    "build:enheduanna": "node scripts/build-site.mjs enheduanna",
    "dev:hildegard": "vite sites/hildegard",
    "build:hildegard": "node scripts/build-site.mjs hildegard",
    "dev:hypatia": "vite sites/hypatia",
    "build:hypatia": "node scripts/build-site.mjs hypatia",
    "dev:melromarc": "vite --config sites/melromarc-sisters/vite.config.ts",
    "build:melromarc": "node scripts/build-site.mjs melromarc-sisters",
    "dev:zhangyong": "vite sites/zhangyong-portrait",
    "build:zhangyong": "node scripts/build-site.mjs zhangyong-portrait",
    "dev:two-swans": "vite sites/malty-melty-childhood",
    "build:two-swans": "node scripts/build-site.mjs malty-melty-childhood",
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .site-build --ignore-pattern docs --ignore-pattern IVORY-ARCHIVE --ignore-pattern ENHEDUANNA --ignore-pattern HILDEGARD --ignore-pattern HYPATIA --ignore-pattern MELROMARC-SISTERS --ignore-pattern THE-LIVING-ATLAS --ignore-pattern ZHANGYONG-PORTRAIT --ignore-pattern MALTY-MELTY-CHILDHOOD --ignore-pattern briefings",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "\u601d\u60f3\u7b80\u62a5\u6863\u6848\u9986"
}
