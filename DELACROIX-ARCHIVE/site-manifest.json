{
  "schemaVersion": 1,
  "id": "delacroix-archive",
  "title": "欧仁·德拉克洛瓦数字档案",
  "slug": "DELACROIX-ARCHIVE",
  "status": "published",
  "languages": ["zh-Hans", "en", "fr"],
  "contentModel": "trilingual historical artist research archive",
  "renderers": [
    {
      "id": "pages",
      "source": "sites/delacroix-archive/",
      "runtime": "static HTML, CSS and JavaScript modules"
    }
  ],
  "capabilities": {
    "trilingualReading": true,
    "hashRoutes": true,
    "workFilters": true,
    "timelineDossiers": true,
    "datedJournalEvidence": true,
    "sourceReverseMapping": true,
    "guidedViewingExperiment": true,
    "localFavorites": true,
    "localResearchNotes": true
  },
  "privacy": {
    "analyticsProvider": null,
    "analyticsNetworkRequests": false,
    "cookies": false,
    "identity": false,
    "localStorage": true,
    "localOnlyFields": ["language", "reading period", "saved works", "work notes"],
    "providerNeutralEvents": ["archive_route_opened", "timeline_event_toggled", "viewing_task_completed"]
  }
}
